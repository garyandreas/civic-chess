# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/
/build

# Environment variables & secrets (WAJIB di-ignore agar tidak bocor ke publik)
.env
.env.*
!.env.example

# Local SQLite database & journals (data lokal tidak ikut ke GitHub publik)
*.db
*.db-journal
*.db-shm
*.db-wal

# Prisma generated client (otomatis dibuat ulang lewat postinstall / prisma generate)
/src/generated/prisma

# Video lokal berukuran besar (sekarang menggunakan link YouTube di src/lib/video-links.ts)
/public/videos/*.mp4
/public/videos/*.mov
/public/videos/*.mkv
!/public/videos/.gitkeep

# Editor & OS files
/.vscode/
/.idea/
.DS_Store
Thumbs.db
*.pem

# Debug logs & TypeScript cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
